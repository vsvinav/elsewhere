exports[`AuthFlow > offers Continue with Google above the email field when a client ID is set, and not otherwise 1`] = `"<main class="ob acct"><section class="bill ob-bill"><div class="peel"><header class="ob-head"><span class="ob-mark" aria-hidden="true">E</span><span class="caps">Sign up</span></header><div class="ob-q"><h2 class="ob-title">Your email</h2><p class="lede">We send a six-digit code. No password, nothing to remember.</p><button class="btn quiet acct-google"><svg/>Continue with Google</button><form class="acct-form"><input id="acct-email" class="ob-input" autocomplete="email" inputmode="email" aria-label="Your email" placeholder="you@example.com" type="email" value=""><div class="ob-actions"><button class="btn" type="submit" disabled="">Continue</button></div></form></div></div><div class="stamp  " style="position: absolute; right: var(--gutter); bottom: 56px;" aria-hidden="true"><div>Account<b>1/2</b>sign up</div></div></section></main>"`;
